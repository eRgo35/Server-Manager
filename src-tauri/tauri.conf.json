{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Server Manager",
  "version": "0.1.0",
  "identifier": "dev.czyz.servermanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Server Manager",
        "width": 360,
        "height": 280,
        "minWidth": 320,
        "minHeight": 240,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "rpm"],
    "category": "Utility",
    "icon": ["icons/icon.png"],
    "linux": {
      "rpm": {
        "depends": ["webkit2gtk4.1"]
      }
    }
  }
}